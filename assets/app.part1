const $ = selector => document.querySelector(selector);
const $$ = selector => [...document.querySelectorAll(selector)];
const state = {
  field: 9.39464,
  pins: [],
  filter: 'all',
  query: '',
  solventIndex: 0,
  solventNucleus: '1H',
  impurityNucleus: '1H',
  inspectorSymbol: null,
  inspectorKey: null
};
let elements = [];
let solventData = [];
let impurityData = [];
const presets = [1, 5, 20, 43, 60, 80, 100, 300, 400, 500, 600, 800, 1000, 1200];
const compoundMetaCache = new Map();
let compoundObserver = null;

const supDigits = '⁰¹²³⁴⁵⁶⁷⁸⁹';
const subDigits = '₀₁₂₃₄₅₆₇₈₉';
const sup = value => String(value ?? '').replace(/\d/g, d => supDigits[Number(d)]);
const nuclideLabel = (mass, symbol) => mass ? `${sup(mass)}${symbol}` : symbol;
const toNumber = value => {
  const n = Number(value);
  return Number.isFinite(n) ? n : null;
};
const trimFixed = (value, decimals = 2) => Number(value).toFixed(decimals).replace(/\.00$/, '').replace(/(\.\d*[1-9])0+$/, '$1');
const compactNumber = value => {
  if (value === '' || value == null) return '—';
  const n = Number(value);
  if (!Number.isFinite(n)) {
    const text = String(value);
    return /^radioactive$/i.test(text) ? 'Rad.' : text;
  }
  const a = Math.abs(n);
  if (a > 0 && a < 0.01) return n.toExponential(2).replace('e+', 'e');
  return trimFixed(n, 2);
};
const formulaHtml = formula => String(formula || '').replace(/(\d+)/g, '<sub>$1</sub>');
const chemicalTextHtml = text => escapeHtml(text).replace(/(\d+)/g, '<sub>$1</sub>');
const frequencyMhz = gamma => {
  const g = toNumber(gamma);
  return g == null ? null : Math.abs(g) * state.field;
};
const comparisonFrequencyText = mhz => {
  if (mhz == null || !Number.isFinite(mhz)) return '—';
  if (mhz >= 1000) return `${(mhz / 1000).toFixed(2)} GHz`;
  if (mhz >= 1) return `${mhz.toFixed(2)} MHz`;
  if (mhz >= 0.001) return `${(mhz * 1000).toFixed(2)} kHz`;
  return `${(mhz * 1e6).toFixed(2)} Hz`;
};
const tableFrequencyScale = () => {
  const h = state.field * gammaH;
  if (h >= 1) return { unit: 'MHz', factor: 1 };
  if (h >= 0.001) return { unit: 'kHz', factor: 1000 };
  return { unit: 'Hz', factor: 1e6 };
};
const tableFrequencyValue = gamma => {
  const mhz = frequencyMhz(gamma);
  if (mhz == null) return '—';
  const { factor } = tableFrequencyScale();
  const value = mhz * factor;
  if (value > 0 && Math.abs(value) < 0.01) return value.toExponential(1).replace('e+', 'e');
  return Number(value).toFixed(2);
};
const mhzToSlider = mhz => Math.round((Math.log10(mhz) - Math.log10(MHZ_MIN)) / (Math.log10(MHZ_MAX) - Math.log10(MHZ_MIN)) * 1000);
const sliderToMhz = value => 10 ** (Math.log10(MHZ_MIN) + (Number(value) / 1000) * (Math.log10(MHZ_MAX) - Math.log10(MHZ_MIN)));
const shiftSortValue = shift => {
  const match = String(shift || '').match(/-?\d+(?:\.\d+)?/);
  return match ? Number(match[0]) : -Infinity;
};
const escapeHtml = text => String(text ?? '').replace(/[&<>"]/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[char]));

async function loadJson(path) {
  const response = await fetch(path);
  if (!response.ok) throw new Error(`${path}: HTTP ${response.status}`);
  return response.json();
}

async function loadData() {
  try {
    const parts = await Promise.all([1, 2, 3, 4].map(async number => {
      const response = await fetch(`data/nmr-data.part${number}`);
      if (!response.ok) throw new Error(`data part ${number}: HTTP ${response.status}`);
      return response.text();
    }));
    if (!('DecompressionStream' in window)) throw new Error('Browser lacks DecompressionStream support');
    const base64 = parts.join('').trim();
    const binary = atob(base64);
    const bytes = new Uint8Array(binary.length);
    for (let index = 0; index < binary.length; index += 1) bytes[index] = binary.charCodeAt(index);
    const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));
    const payload = JSON.parse(await new Response(stream).text());
    elements = payload.isotopes.map(element => {
      const fullCol = Math.round(Number(element.x) / 2.618) + 1;
      const y = Number(element.y);
      let series = 'main';
      let period = null;
      if (y > -14) period = Math.round(-y / 2.618) + 1;
      else if (Math.abs(y + 16) < 0.6) { series = 'lanthanide'; period = 6; }
      else { series = 'actinide'; period = 7; }
      const group = series === 'main' ? fullCol : null;
      const block = series !== 'main' ? 'f' : group <= 2 ? 's' : group <= 12 ? 'd' : 'p';
      return { ...element, full_col: fullCol, period, series, group, block };
    });
    solventData = payload.solvents.map(solvent => {